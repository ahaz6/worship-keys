NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Set only on Vercel so `/` becomes the cloud setlist planner.
NEXT_PUBLIC_WORSHIP_KEYS_CLOUD=1

# Server-only Google Drive deployment credentials. Share the target folder
# with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor. Never prefix these with NEXT_PUBLIC_.
GOOGLE_SERVICE_ACCOUNT_EMAIL=worship-keys@YOUR_PROJECT.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=1pD8L0WbTM-i_HdhGT13vM3kbNDVWVcpB
# Pre-created Drive file shared with the service account. This keeps access
# narrower than granting the service account the entire folder.
GOOGLE_DRIVE_FILE_ID=YOUR_SHARED_JSON_FILE_ID
# Comma-separated Supabase user UUIDs allowed to replace the church Drive file.
GOOGLE_DRIVE_DEPLOY_USER_IDS=YOUR_SUPABASE_USER_ID
